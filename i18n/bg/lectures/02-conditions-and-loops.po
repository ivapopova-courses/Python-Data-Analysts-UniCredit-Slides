msgid "Truth"
msgstr "Истинност"

#. table cell
#: site/lectures/02-conditions-and-loops.md:1484
msgid "`0`, `0.0`, `\"\"`, `None`, empty collections are false; everything else is true"
msgstr "`0`, `0.0`, `\"\"`, `None`, празните колекции са falsy; всичко останало е truthy"

