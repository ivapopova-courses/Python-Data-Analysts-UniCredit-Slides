#. html
#: site/lectures/02-conditions-and-loops.md:8
msgid "<span>Session 2</span><span>practice: <code>02-conditions-and-loops/</code> in the homework repository</span>"
msgstr "<span>Занятие 2</span><span>упражнения: <code>02-conditions-and-loops/</code> в homework repository</span>"

#. html
#: site/lectures/02-conditions-and-loops.md:9
