#. heading 2
#: site/lectures/04-functions.md:1377
msgid "Summary"
msgstr "Обобщение"

#. table cell
#: site/lectures/04-functions.md:1379
msgid "Topic"
msgstr "Тема"

#. table cell
#: site/lectures/04-functions.md:1379
msgid "Remember"
msgstr "Запомнете"

#. table cell
#: site/lectures/04-functions.md:1381
msgid "Define, call"
msgstr "Дефиниране, извикване"

#. table cell
#: site/lectures/04-functions.md:1381
msgid "`def name(params):` + an indented body; `name(args)` runs it - the brackets are required"
msgstr "`def name(params):` + отместено навътре тяло; `name(args)` я изпълнява - скобите са задължителни"

#. table cell
#: site/lectures/04-functions.md:1382
msgid "positional; defaults after the others; `name=value` in the call; `*args` a tuple, `**kwargs` a dictionary"
msgstr "позиционни; стойностите по подразбиране - след останалите; `name=value` при извикване; `*args` е tuple, `**kwargs` е dictionary"

#. table cell
