msgid "Comprehension"
msgstr "Comprehension"

#. table cell
#: site/lectures/06-dictionaries.md:1048
msgid "Lookups"
msgstr "Lookups"

#. table cell
#: site/lectures/06-dictionaries.md:1048
msgid "a dict = a SAS format / hash object / lookup table; `get(code, \"Other\")` = `OTHER=`"
msgstr "dict = SAS format / hash обект / lookup таблица; `get(code, \"Other\")` = `OTHER=`"

#. table cell
#: site/lectures/06-dictionaries.md:1049
msgid "Join"
msgstr "Join"

#. table cell
#: site/lectures/06-dictionaries.md:1049
msgid "a dict of the right table, `get` for every row of the left one = `LEFT JOIN`"
msgstr "dict от дясната таблица и `get` за всеки ред от лявата = `LEFT JOIN`"

#. table cell
#: site/lectures/06-dictionaries.md:1050
msgid "Ranges"
msgstr "Диапазони"

#. table cell
#: site/lectures/06-dictionaries.md:1050
msgid "not keys: a function with `if`, or `bisect`"
msgstr "не са ключове: функция с `if` или `bisect`"

#. table cell
#: site/lectures/06-dictionaries.md:1052
msgid "Several keys"
msgstr "Няколко ключа"

#. table cell
#: site/lectures/06-dictionaries.md:1052
msgid "a tuple as the key: `(segment, stage)`"
msgstr "tuple като ключ: `(segment, stage)`"

#. table cell
#: site/lectures/06-dictionaries.md:1053
msgid "Records"
msgstr "Записи"

#. table cell
#: site/lectures/06-dictionaries.md:1053
msgid "`csv.DictReader`: rows as dicts; a dict of dicts keyed by id; optional: `json.dumps` / `loads`"
msgstr "`csv.DictReader`: редове като dicts; dict от dicts с ключ идентификатора; по желание: `json.dumps` / `loads`"

#. table cell
#: site/lectures/06-dictionaries.md:1054
msgid "Copies"
msgstr "Копия"

