#: site/sample-data.md:28
msgid "`loans.csv` as a local export: `;`, decimal comma, `dd.mm.yyyy`, missing values, duplicates"
msgstr "`loans.csv` като локален експорт: `;`, десетична запетая, `dd.mm.yyyy`, липсващи стойности, повторения"

#. table cell
#: site/sample-data.md:29
msgid "4 tables"
msgstr "4 таблици"

#. table cell
